# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT TEMPLATE
#
#   cp .env.production.example .env.production   # then fill in REAL secrets
#
# NEVER commit .env.production. Generate strong secrets, e.g.:
#   openssl rand -base64 48      → BETTER_AUTH_SECRET
#   openssl rand -hex 32         → ANALYTICS_SALT / POSTGRES_PASSWORD
#
# In a managed-infra deployment (RDS, Upstash, etc.) set DATABASE_URL / REDIS_URL
# to the managed endpoints and remove the bundled postgres/redis services.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://blog.example.com
API_URL=https://api.example.com
ADMIN_URL=https://admin.example.com
PORT=3003
LOG_LEVEL=info

# Inlined into the Next.js client bundle at BUILD time (docker compose build args).
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by the bundled postgres service AND composed into DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=blog_platform
# Inside the compose network the host is the service name `postgres`.
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@postgres:5432/blog_platform

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# MUST be >= 32 chars. The API refuses to start in production with the dev default.
BETTER_AUTH_SECRET=CHANGE_ME_min_32_char_random_secret_value
BETTER_AUTH_URL=https://api.example.com/api/v1/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── CORS — exact origins, comma-separated, no trailing slash ─────────────────
CORS_ORIGINS=https://blog.example.com,https://admin.example.com

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── S3 / Cloudflare R2 ───────────────────────────────────────────────────────
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=blog-media
S3_PUBLIC_URL=https://media.example.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@example.com

# ── Analytics ────────────────────────────────────────────────────────────────
# MUST differ from the dev default in production (used to hash visitor IPs).
ANALYTICS_SALT=CHANGE_ME_random_salt

# ── Error monitoring (optional, Sentry-ready) ────────────────────────────────
# Leave blank to disable. When set, unhandled errors are reported.
SENTRY_DSN=

# ── Off-site DB backups (tooling/scripts/backup-db.sh) ───────────────────────
BACKUP_S3_BUCKET=s3://blog-db-backups
BACKUP_RETENTION_DAYS=30
